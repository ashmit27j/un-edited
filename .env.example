# Copy to .env.local (ignored by git) and fill in from the Supabase dashboard:
# Project Settings > API (or the "Connect" dialog).
# Use the anon / publishable key. Never put the service_role / secret key here:
# EXPO_PUBLIC_ variables are bundled into the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key

# Google sign-in needs NOTHING in this file. The Google client ID and client secret
# go in the Supabase dashboard only (Authentication > Providers > Google), because
# the app starts the sign-in through Supabase and never talks to Google directly.
# Putting the secret in an EXPO_PUBLIC_ variable would publish it inside the app.
#
# Google Cloud Console (APIs & Services > Credentials > OAuth client ID, type "Web application"):
#   Authorized redirect URI:  https://your-project-ref.supabase.co/auth/v1/callback
# Supabase dashboard (Authentication > URL Configuration > Redirect URLs), add:
#   unedited://sign-in
#   http://localhost:8081/sign-in
#   https://your-production-domain/sign-in

# Web Push: the public VAPID key (the private half goes in supabase/.env, never here).
# Generate a pair with: npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
